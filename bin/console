#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Pricing\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

require dirname(__DIR__).'/vendor/autoload.php';

$environment = $_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'dev';
$debug = filter_var($_SERVER['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? ('prod' !== $environment), FILTER_VALIDATE_BOOL);
$arguments = $_SERVER['argv'] ?? [];
foreach ($arguments as $index => $argument) {
    if ('--env' === $argument || '-e' === $argument) {
        $environment = $arguments[$index + 1] ?? $environment;
        continue;
    }
    if (str_starts_with($argument, '--env=')) {
        $environment = substr($argument, strlen('--env='));
        continue;
    }
    if (str_starts_with($argument, '-e=')) {
        $environment = substr($argument, strlen('-e='));
        continue;
    }
    if ('--no-debug' === $argument) {
        $debug = false;
    }
}

$kernel = new Kernel($environment, $debug);
$application = new Application($kernel);
$application->run();

