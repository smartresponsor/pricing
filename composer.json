{
  "name": "pricing/price",
  "description": "SmartResponsor Pricing component for reusable price definitions and deterministic price selection.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "currencing/currency": "dev-master",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.5",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/console": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\Pricing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Pricing\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/currencing.git",
      "no-api": true
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "extra": {
    "symfony": {
      "bundle": "App\\Pricing\\PricingBundle",
      "require": "^8.1"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:behavioral-coverage": "@php tool/price-behavioral-ui-coverage.php",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --branch-coverage --coverage-text=var/coverage/summary.txt --coverage-clover=var/coverage/clover.xml"
    ],
    "phpstan": "phpstan analyse -c phpstan.neon",
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "schema:validate": "@php bin/console doctrine:schema:validate --skip-sync --env=test --no-interaction",
    "schema:parity": [
      "@php bin/console doctrine:migrations:migrate --env=test --no-interaction",
      "@php tool/price-schema-parity.php",
      "@php bin/console doctrine:migrations:up-to-date --env=test --no-interaction"
    ],
    "gate": "@php vendor/bin/gating check --target=. --profile=config/price_gating_profile.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml",
    "gate:strict": "@php vendor/bin/gating check --target=. --profile=config/price_gating_profile.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml --rule-set=vendor/gating/gate/.gating/profile/rule-set/strict.yaml",
    "quality": [
      "@test",
      "@phpstan",
      "@cs:check",
      "@schema:parity",
      "@test:behavioral-coverage",
      "@gate"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
